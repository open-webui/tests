# Open WebUI test configuration. Copy to .env to override any of these.
# The integration and browser suites boot their own scratch instance from the checkout and
# seed its accounts, so nothing here is needed to run them.

# Checkout under test (default: a sibling open-webui/ next to this repo)
# OPEN_WEBUI_SOURCE_DIR=/path/to/open-webui/backend
# Built frontend the browser suite serves (default: build/ next to that backend)
# OPEN_WEBUI_BUILD_DIR=/path/to/open-webui/build
# Keep each scratch instance's server log here
# OPEN_WEBUI_LOG_DIR=test-results/server-logs

# Browser settings
HEADLESS=true
SLOW_MO=0

# Timeout settings (in milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# Only test_running_instance_health reads this: an instance you started yourself
# OPEN_WEBUI_URL=http://localhost:8080
